NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Discord WidgetBot (Resources > Community tab)
NEXT_PUBLIC_DISCORD_GUILD_ID=
NEXT_PUBLIC_DISCORD_CHANNEL_ID=

# Rebrandly — student referral short links
# Required: /api/referral-link registers each referral code as a Rebrandly link
# on the application.imaccelerator.com branded domain. All three vars are
# required. If any is missing the route returns 500.
#
#  REBRANDLY_API_KEY       — account API key (https://app.rebrandly.com/account/api-keys).
#                            Verify with: curl https://api.rebrandly.com/v1/account -H "apikey: $KEY"
#  REBRANDLY_WORKSPACE_ID  — id of the workspace owning the branded domain. Find with:
#                            curl https://api.rebrandly.com/v1/workspaces -H "apikey: $KEY"
#                            (use the "Main Workspace" id if the account has several).
#  REBRANDLY_DOMAIN_ID     — id of the application.imaccelerator.com branded domain. Find with:
#                            curl https://api.rebrandly.com/v1/domains -H "apikey: $KEY" -H "workspace: $WS"
REBRANDLY_API_KEY=
REBRANDLY_WORKSPACE_ID=
REBRANDLY_DOMAIN_ID=

# Web Push — daily "reason to return" reminders.
# Generate a VAPID key pair once with:  npx web-push generate-vapid-keys
#   - NEXT_PUBLIC_VAPID_PUBLIC_KEY : the public key (exposed to the browser so it
#                                    can subscribe). MUST equal VAPID_PUBLIC_KEY.
#   - VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY : the key pair used server-side to sign
#                                    push payloads. If unset, the push opt-in UI
#                                    hides itself and the reminder cron no-ops.
#   - VAPID_SUBJECT : a mailto: or https: contact URL (push services require it).
# If any of these is missing, push degrades gracefully (in-app streak still works).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@imaccelerator.com

# Shared secret guarding the daily reminder cron (/api/push/send-reminders).
# Vercel Cron automatically sends "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# App origin used for CSRF Origin checks (set in production, e.g.
# https://application.imaccelerator.com).
NEXT_PUBLIC_APP_URL=
